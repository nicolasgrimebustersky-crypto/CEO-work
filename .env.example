# ---------------------------------------------------------------------------
# Grime Busters CRM — local environment
# Fill every value in. Nothing here is committed (.env*.local is gitignored).
# The same values must also be added in Vercel → Project → Settings → Env Vars.
# ---------------------------------------------------------------------------

# Google Maps — enable Maps JavaScript API, Geocoding API, Places API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional but recommended. A Map ID (Google Cloud → Maps → Map Management)
# is required for Advanced Markers. Leave blank to fall back to DEMO_MAP_ID,
# which works but shows Google's demo styling watermark.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Firebase web app config (Firebase console → Project settings → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Push notifications. Firebase console → Project settings → Cloud Messaging →
# Web configuration → "Web Push certificates" → Generate key pair, then paste
# the key pair's public key here. Public by design: it is the applicationServerKey
# a browser needs to create a push subscription.
#
# Leave blank and everything still works — the bell inside the app, the records,
# the settings screen — but nothing reaches a phone with the app closed, and the
# Account screen says so rather than showing a dead switch.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# What gets printed at the top of an estimate or invoice. All public by design —
# they are on a document handed to a stranger. Blank falls back to the values in
# lib/business.ts.
NEXT_PUBLIC_BUSINESS_WEBSITE=

# Twilio — SERVER SIDE ONLY. Never prefix these with NEXT_PUBLIC_.
# Used from Phase 3 onward (/api/sms/*).
#
# The Account SID (AC…) is an identifier, not a secret — it appears in Twilio's
# own REST URLs. The other two are secrets and must be treated as such.
TWILIO_ACCOUNT_SID=
TWILIO_PHONE_NUMBER=

# Preferred way to authenticate sending: an API key, which can be deleted in the
# console the moment it leaks without resetting the account's own token.
# Twilio Console → Account → API keys & tokens → Create API key.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Still required even when using an API key, because Twilio signs inbound
# webhooks with the account auth token and never with an API key secret. Without
# it /api/sms/inbound refuses every request rather than trusting unverified ones,
# so replies would stop landing on the customer timeline.
TWILIO_AUTH_TOKEN=

# Set to "true" to point the app at the local Firebase emulators
# (npm run emulators) instead of the real project. Leave blank in production.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=

# ---------------------------------------------------------------------------
# Server-side only (added in Phase 2/3). None of these may be prefixed with
# NEXT_PUBLIC_ — they must never reach the browser.
# ---------------------------------------------------------------------------

# Firebase service-account JSON, base64-encoded. Required by the SMS routes and
# the nightly cron, which run with the Admin SDK.
#   base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT_KEY=

# Comma-separated uids of the two crew accounts. API routes bypass Firestore
# rules, so they re-check the caller against this list. Keep it in sync with the
# allowlist in firestore.rules and storage.rules. Empty = every request denied.
CREW_UIDS=

# Shared secret for the Vercel cron that sends quote follow-ups.
#   openssl rand -hex 32
CRON_SECRET=

# Optional. Only needed if Twilio signature validation fails because the
# deployment sits behind a proxy that rewrites the host.
TWILIO_WEBHOOK_URL=

# Optional. Firebase App Check site key (reCAPTCHA v3). When set, the app
# attests that requests come from this app on a real device — see SECURITY.md.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Optional escape hatch. Set to "true" to downgrade the Content-Security-Policy
# to report-only if a change ever breaks the map, while you find the missing
# source. Do not leave it on.
CSP_REPORT_ONLY=

# ---------------------------------------------------------------------------
# iOS / Capacitor
# ---------------------------------------------------------------------------

# Required for native builds only. The bundled app has no API routes of its own,
# so it calls the deployed ones. Leave blank for web builds (relative URLs).
#   NEXT_PUBLIC_API_BASE_URL=https://your-app.vercel.app
NEXT_PUBLIC_API_BASE_URL=

# Canonical site origin, used to allow your own deployment through CORS.
NEXT_PUBLIC_SITE_URL=

# The host a customer's estimate link is built from. Optional, and worth
# setting: without it the link a customer receives is the CRM's own address,
# which reads as an internal tool and invites the question of what else is on
# it. Point a domain you already own at the same Vercel project — Vercel →
# Project → Domains → Add — and put it here, with the scheme:
#   NEXT_PUBLIC_QUOTE_URL=https://quote.yourdomain.com
# One deployment serves both names; nothing is deployed twice.
NEXT_PUBLIC_QUOTE_URL=

# ---------------------------------------------------------------------------
# Meta Lead Ads (Facebook / Instagram lead forms) — server side only.
# Full walkthrough in docs/META_LEADS.md.
# ---------------------------------------------------------------------------

# App Secret: developers.facebook.com -> your app -> Settings -> Basic
META_APP_SECRET=

# You invent this; it only has to match what you enter in the Webhooks screen.
#   openssl rand -hex 16
META_VERIFY_TOKEN=

# Long-lived PAGE access token with leads_retrieval. A user token will not work
# and a short-lived one expires in an hour — see the doc for the exchange.
META_PAGE_ACCESS_TOKEN=

# Optional. Your Facebook Page ID, used to ignore leads from other Pages.
META_PAGE_ID=

# Set to "true" to run the whole app on an invented in-memory dataset instead
# of Firebase — for a preview link before the Firebase project exists. Read at
# BUILD time. See docs/DEPLOY.md. Never set this on a production deployment.
NEXT_PUBLIC_DEMO_MODE=

# ---------------------------------------------------------------- Claude API
# Drafting estimate wording from a spoken description and photos.
#
# Server-only, and deliberately without the NEXT_PUBLIC_ prefix: the prefix
# would ship the key to every browser that loads the app, and anyone who opened
# devtools could spend it. The route that uses it (/api/estimate/draft) checks
# the caller is signed-in crew and rate-limits them first.
#
# Leave it unset and the estimate builder still works — the "Draft it for me"
# button reports that the deployment has no key, and every line can be typed by
# hand as before.
ANTHROPIC_API_KEY=

# ------------------------------------------------------------- the Ops Agent
# Nothing to set. API keys for the MCP server at /api/mcp are generated inside
# the app (Account -> API keys) and stored hashed in Firestore, so there is no
# environment variable holding one. See the README.
