# ---------------------------------------------------------------------------
# Grime Busters CRM — local environment
# Fill every value in. Nothing here is committed (.env*.local is gitignored).
# The same values must also be added in Vercel → Project → Settings → Env Vars.
# ---------------------------------------------------------------------------

# Google Maps — enable Maps JavaScript API, Geocoding API, Places API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional but recommended. A Map ID (Google Cloud → Maps → Map Management)
# is required for Advanced Markers. Leave blank to fall back to DEMO_MAP_ID,
# which works but shows Google's demo styling watermark.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Firebase web app config (Firebase console → Project settings → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Twilio — SERVER SIDE ONLY. Never prefix these with NEXT_PUBLIC_.
# Used from Phase 3 onward (/api/sms/*).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Set to "true" to point the app at the local Firebase emulators
# (npm run emulators) instead of the real project. Leave blank in production.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=

# ---------------------------------------------------------------------------
# Server-side only (added in Phase 2/3). None of these may be prefixed with
# NEXT_PUBLIC_ — they must never reach the browser.
# ---------------------------------------------------------------------------

# Firebase service-account JSON, base64-encoded. Required by the SMS routes and
# the nightly cron, which run with the Admin SDK.
#   base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT_KEY=

# Comma-separated uids of the two crew accounts. API routes bypass Firestore
# rules, so they re-check the caller against this list. Keep it in sync with the
# allowlist in firestore.rules and storage.rules. Empty = every request denied.
CREW_UIDS=

# Shared secret for the Vercel cron that sends quote follow-ups.
#   openssl rand -hex 32
CRON_SECRET=

# Optional. Only needed if Twilio signature validation fails because the
# deployment sits behind a proxy that rewrites the host.
TWILIO_WEBHOOK_URL=
