# ---------------------------------------------------------------------------
# Grime Busters CRM — local environment
# Fill every value in. Nothing here is committed (.env*.local is gitignored).
# The same values must also be added in Vercel → Project → Settings → Env Vars.
# ---------------------------------------------------------------------------

# Google Maps — enable Maps JavaScript API, Geocoding API, Places API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional but recommended. A Map ID (Google Cloud → Maps → Map Management)
# is required for Advanced Markers. Leave blank to fall back to DEMO_MAP_ID,
# which works but shows Google's demo styling watermark.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Firebase web app config (Firebase console → Project settings → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Twilio — SERVER SIDE ONLY. Never prefix these with NEXT_PUBLIC_.
# Used from Phase 3 onward (/api/sms/*).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Set to "true" to point the app at the local Firebase emulators
# (npm run emulators) instead of the real project. Leave blank in production.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=

# ---------------------------------------------------------------------------
# Server-side only (added in Phase 2/3). None of these may be prefixed with
# NEXT_PUBLIC_ — they must never reach the browser.
# ---------------------------------------------------------------------------

# Firebase service-account JSON, base64-encoded. Required by the SMS routes and
# the nightly cron, which run with the Admin SDK.
#   base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT_KEY=

# Comma-separated uids of the two crew accounts. API routes bypass Firestore
# rules, so they re-check the caller against this list. Keep it in sync with the
# allowlist in firestore.rules and storage.rules. Empty = every request denied.
CREW_UIDS=

# Shared secret for the Vercel cron that sends quote follow-ups.
#   openssl rand -hex 32
CRON_SECRET=

# Optional. Only needed if Twilio signature validation fails because the
# deployment sits behind a proxy that rewrites the host.
TWILIO_WEBHOOK_URL=

# Optional. Firebase App Check site key (reCAPTCHA v3). When set, the app
# attests that requests come from this app on a real device — see SECURITY.md.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Optional escape hatch. Set to "true" to downgrade the Content-Security-Policy
# to report-only if a change ever breaks the map, while you find the missing
# source. Do not leave it on.
CSP_REPORT_ONLY=

# ---------------------------------------------------------------------------
# iOS / Capacitor
# ---------------------------------------------------------------------------

# Required for native builds only. The bundled app has no API routes of its own,
# so it calls the deployed ones. Leave blank for web builds (relative URLs).
#   NEXT_PUBLIC_API_BASE_URL=https://your-app.vercel.app
NEXT_PUBLIC_API_BASE_URL=

# Canonical site origin, used to allow your own deployment through CORS.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Meta Lead Ads (Facebook / Instagram lead forms) — server side only.
# Full walkthrough in docs/META_LEADS.md.
# ---------------------------------------------------------------------------

# App Secret: developers.facebook.com -> your app -> Settings -> Basic
META_APP_SECRET=

# You invent this; it only has to match what you enter in the Webhooks screen.
#   openssl rand -hex 16
META_VERIFY_TOKEN=

# Long-lived PAGE access token with leads_retrieval. A user token will not work
# and a short-lived one expires in an hour — see the doc for the exchange.
META_PAGE_ACCESS_TOKEN=

# Optional. Your Facebook Page ID, used to ignore leads from other Pages.
META_PAGE_ID=

# Set to "true" to run the whole app on an invented in-memory dataset instead
# of Firebase — for a preview link before the Firebase project exists. Read at
# BUILD time. See docs/DEPLOY.md. Never set this on a production deployment.
NEXT_PUBLIC_DEMO_MODE=
