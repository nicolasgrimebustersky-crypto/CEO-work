# Copy to .env and fill in. NEVER commit .env.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Firestore (GrimelineCRM), read-only service account
GOOGLE_APPLICATION_CREDENTIALS=./firebase-readonly.json
FIREBASE_PROJECT_ID=

# Optional. Overrides the Telegram endpoint, for testing against a stand-in
# API. Leave unset in normal use.
# TELEGRAM_API_BASE=https://api.telegram.org
