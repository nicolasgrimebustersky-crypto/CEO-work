rules_version = '2';

// ---------------------------------------------------------------------------
// Grime Busters CRM — Firestore security rules.
//
// Anybody can register. Almost nobody can read anything.
//
// A new account lands as `pending`: it can sign in, read its own profile, and
// nothing else. Every customer, job, invoice and message is denied until an
// existing crew member approves it. That is the entire point of opening sign
// up without opening the data — this database holds real people's home
// addresses and phone numbers.
//
// Granting access is one account's job — see isAdmin() below. Everyone else,
// including the other owner, uses the whole app and hands out nothing.
//
// Two uids below are crew unconditionally. They are the bootstrap: the first
// account cannot wait for an approver who does not exist yet, and a profile
// damaged by a bad write must not lock both owners out of their own business.
//
// The escalation this file exists to stop is one line long: sign up, then
// write your own profile with role 'crew'. See the /users rules.
//
// Keep the uid list in step with lib/auth/roles.ts. Deploy with:
//   npx firebase-tools deploy --only firestore:rules
//
// `npm run test:rules` exercises everything below against the emulator.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // The single admin: the only account that can grant or remove access.
    //
    // Derived from the signed-in email, never from a stored field. If "admin"
    // lived in the database then anybody who could write that field could mint
    // an admin, and the one account that matters would be only as safe as
    // every write path in the app. Firebase enforces one account per email, so
    // this cannot be claimed by registering either.
    //
    // Keep in step with ADMIN_EMAIL in lib/auth/roles.ts.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'nicolas.grimebustersky@gmail.com';
    }

    // Crew by uid, whatever the database says. The bootstrap.
    function isBootstrapCrew() {
      return request.auth != null
        && request.auth.uid in [
             'Bzo7rclax4SdT7PaAua1monNxXG3',
             'QLMsTAHbbceHBAWBXPqtScGdGon2'
           ];
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Crew by approval. The `exists` guard matters: `get` on a missing document
    // is an error, and an account that signed up but whose profile write failed
    // would otherwise take every rule down with it rather than being denied.
    //
    // Compared against the literal 'crew'. A missing field, a null or a typo
    // all land as not-crew, which is the direction a mistake has to fail in.
    function isApprovedCrew() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myProfile().role == 'crew';
    }

    // The admin is always crew — an admin locked out by their own profile
    // could never reach the screen that fixes it.
    function isCrew() {
      return isAdmin() || isBootstrapCrew() || isApprovedCrew();
    }

    // True when this write touches neither of the fields the admin owns.
    //
    // `role` is whether you can use the app; `notificationScopes` is which
    // categories you are allowed to hear about. Both are granted *to* you, so
    // neither may be edited *by* you — a person who could widen their own
    // scope would make the permission decorative.
    function keepsAdminGrants() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'notificationScopes']);
    }

    // Every write is stamped with its author. Enforcing it here rather than
    // trusting the client means an attribution can't be forged even if
    // someone runs modified code with a valid session.
    function stampedByCaller(field) {
      return request.resource.data[field] == request.auth.uid;
    }

    // On an update, `request.resource.data` is the *merged* document, so a
    // payload that simply omits `updatedBy` would inherit the stored value and
    // sail through a bare equality check. Requiring `updatedAt` to appear in
    // the diff forces every update to actually refresh the stamp, which is
    // what makes the "edited by [name] at [time]" line trustworthy.
    function refreshesAuthorStamp() {
      return stampedByCaller('updatedBy')
        && request.resource.data.diff(resource.data).affectedKeys().hasAll(['updatedAt']);
    }

    // Profiles. This is the one collection a pending account can touch, and
    // every clause here is load-bearing.
    match /users/{uid} {
      // You can always read your own profile. That is how a pending account
      // finds out it is pending — without it the app could only show a blank
      // screen to somebody who just registered. Crew read everyone, for the
      // roster and the map dots.
      allow read: if request.auth != null
        && (isCrew() || request.auth.uid == uid);

      // Registering writes your own profile, and it must land as 'pending'.
      // Bootstrap accounts are exempt or the very first sign-in deadlocks
      // waiting for an approver who does not exist.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && (isBootstrapCrew() || request.resource.data.role == 'pending');

      // Two separate permissions, deliberately not one:
      //
      //   Your own profile — name, phone, location, notification settings —
      //   but NOT your own role. Allowing that would make the sign-up form a
      //   complete privilege escalation: register, then promote yourself.
      //
      //   Somebody else's grants, if you are the admin: `role` and
      //   `notificationScopes`, and nothing else. Granting is one person's
      //   job, so crew who are not the admin cannot do it — they use the app
      //   fully and hand out nothing. Restricting the editable keys means an
      //   approver cannot rewrite the name or GPS position of the account
      //   they are letting in.
      allow update: if request.auth != null && (
        (request.auth.uid == uid && keepsAdminGrants())
        || (isAdmin()
            && request.auth.uid != uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['role', 'notificationScopes']))
      );

      // Deleting your own profile is the in-app account deletion App Store
      // Guideline 5.1.1(v) requires. Owner-only: one crew member must not be
      // able to erase the other.
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Light shape checks. These are not a schema — they exist to stop a bug in
    // one client from writing a document the other client cannot render, which
    // in a two-device app looks like data loss.
    function validCustomer() {
      let data = request.resource.data;
      return data.status in ['lead', 'quoted', 'customer', 'not_interested', 'do_not_knock']
        && data.pipelineStage in [
             'new_lead', 'estimate_sent', 'estimate_accepted', 'job_scheduled',
             'awaiting_payment', 'paid', 'lost'
           ]
        && data.lat is number
        && data.lng is number
        && data.notes is list;
    }

    function validJob() {
      let data = request.resource.data;
      return data.status in ['scheduled', 'in_progress', 'complete', 'cancelled']
        && data.serviceType in ['pressure_washing', 'landscaping', 'snow_removal']
        && data.price is number
        && data.price >= 0
        && data.customerId is string
        && data.assignedTo is list;
    }

    // Estimates and invoices share one shape and one collection, so one check
    // covers both. `number` is pinned separately below: two documents carrying
    // the same number is the one error that makes the books unreadable.
    function validDocument() {
      let data = request.resource.data;
      return data.kind in ['estimate', 'invoice']
        && data.status in ['draft', 'sent', 'accepted', 'declined', 'partial', 'paid', 'void']
        && data.serviceType in ['pressure_washing', 'landscaping', 'snow_removal']
        && data.customerId is string
        && data.number is string
        && data.lineItems is list
        && data.payments is list
        && data.discount is number
        && data.discount >= 0
        && data.taxRatePct is number
        && data.taxRatePct >= 0
        && data.subtotal is number
        && data.total is number
        && data.total >= 0
        && data.amountPaid is number
        && data.amountPaid >= 0
        && data.balanceDue is number;
    }

    // The price book. Written automatically whenever a service is used on an
    // estimate, so the validation is deliberately loose on text and strict on
    // money — a bad price silently propagates onto future quotes.
    function validService() {
      let data = request.resource.data;
      return data.name is string
        && data.name.size() > 0
        && data.description is string
        && data.unitPrice is number
        && data.unitPrice >= 0
        && data.serviceType in ['pressure_washing', 'landscaping', 'snow_removal']
        && data.taxable is bool
        && data.timesUsed is number
        && data.timesUsed >= 0;
    }

    function validQuote() {
      let data = request.resource.data;
      return data.status in ['sent', 'accepted', 'declined', 'no_response']
        && data.serviceType in ['pressure_washing', 'landscaping', 'snow_removal']
        && data.amount is number
        && data.amount >= 0
        && data.customerId is string;
    }

    match /customers/{customerId} {
      allow read: if isCrew();
      allow create: if isCrew() && stampedByCaller('createdBy') && validCustomer();
      allow update: if isCrew() && refreshesAuthorStamp() && validCustomer();
      allow delete: if isCrew();
    }

    // Jobs carry the same author stamps as customers — the calendar shows who
    // scheduled and who last touched each block, and that has to be as hard to
    // forge as the note attributions are.
    match /jobs/{jobId} {
      allow read: if isCrew();
      allow create: if isCrew() && stampedByCaller('createdBy') && validJob();
      allow update: if isCrew() && refreshesAuthorStamp() && validJob();
      allow delete: if isCrew();
    }

    // Quotes have no updatedBy field — the only client-side update is flipping
    // the status, and the nightly follow-up cron writes through the Admin SDK
    // and bypasses these rules entirely. So instead of a refresh check, the
    // rule pins the original sender: a quote cannot be reassigned to the other
    // crew member after the fact.
    match /quotes/{quoteId} {
      allow read: if isCrew();
      allow create: if isCrew() && stampedByCaller('sentBy') && validQuote();
      allow update: if isCrew()
        && validQuote()
        && request.resource.data.sentBy == resource.data.sentBy
        && request.resource.data.customerId == resource.data.customerId;
      allow delete: if isCrew();
    }

    // Estimates and invoices. These are the financial record, so two things are
    // frozen once the document exists: its number and the customer it belongs
    // to. Renumbering an invoice after it has been sent, or moving it to
    // another customer, would silently rewrite history — and unlike a wrong
    // price, neither leaves any trace of what it used to say.
    match /documents/{documentId} {
      allow read: if isCrew();
      allow create: if isCrew() && stampedByCaller('createdBy') && validDocument();
      allow update: if isCrew()
        && refreshesAuthorStamp()
        && validDocument()
        && request.resource.data.number == resource.data.number
        && request.resource.data.customerId == resource.data.customerId;
      allow delete: if isCrew();
    }

    // The price book is shared reference data, not a record of anything that
    // happened, so there is no author stamp to refresh on update — the whole
    // point is that using a service updates its price and its usage count
    // without anyone opening a form.
    match /services/{serviceId} {
      allow read: if isCrew();
      allow create: if isCrew() && stampedByCaller('createdBy') && validService();
      allow update: if isCrew() && validService();
      allow delete: if isCrew();
    }

    // Notifications are addressed to a person and describe what someone else
    // did, so both ends are pinned: you may only create one attributed to
    // yourself, and the only field you may later change is readAt.
    // A notification is addressed to one person, and only that person may read
    // it.
    //
    // This used to be crew-wide, on the reasoning that both accounts could
    // already read every other collection. Team chat broke that reasoning: a
    // chat notification carries the first sixty characters of a private
    // message in its body, so crew-wide read would hand every thread's content
    // to people the conversation rules deliberately exclude — including the
    // admin, who cannot read the threads themselves.
    //
    // The client already queried `where forUid == me`. Rules are the boundary,
    // though, and a modified client or a direct REST call with a valid token
    // is not bound by the query the app happens to send.
    function myNotification() {
      return resource.data.forUid == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow read: if isCrew() && myNotification();
      allow create: if isCrew()
        && stampedByCaller('actorUid')
        && request.resource.data.forUid is string
        && request.resource.data.readAt == null;
      // Marking read and clearing are things you do to your own bell.
      allow update: if isCrew()
        && myNotification()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
      allow delete: if isCrew() && myNotification();
    }

    // One document per device that has agreed to receive push notifications.
    //
    // A token is a capability: anyone holding one can have a notification
    // delivered to that handset. So a device may only ever file itself —
    // `uid` must be the caller — which stops one account from registering a
    // token against the other and quietly receiving their notifications.
    //
    // Read stays crew-wide because both accounts already read every other
    // collection, and the sending side runs with the Admin SDK anyway. Delete
    // is crew-wide so signing out on a shared handset can clean up after
    // itself.
    function validPushToken() {
      let data = request.resource.data;
      return data.uid == request.auth.uid
        && data.token is string
        && data.token.size() > 0
        && data.token.size() < 1000;
    }

    match /pushTokens/{tokenId} {
      allow read: if isCrew();
      allow create: if isCrew() && validPushToken();
      // Both identifying fields are pinned on update. Without that, `uid ==
      // request.auth.uid` is satisfied by *rewriting* uid to yourself — which
      // would point your own notifications at the other person's handset. The
      // document id is derived from the token, so a genuinely new token is a
      // new document and never an edit of this one.
      allow update: if isCrew()
        && validPushToken()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.token == resource.data.token;
      allow delete: if isCrew();
    }

    // Door-knocking routes: a named, ordered list of doors somebody is walking.
    //
    // Both crew may edit any route, including reassigning one — that is the
    // point of a two-person app where either of you might pick up the other's
    // afternoon. What is pinned is the *shape*: the lists have to be lists and
    // the status has to be one the UI can render, so a bug on one phone cannot
    // write a route the other phone refuses to open.
    function validKnockRoute() {
      let data = request.resource.data;
      return data.name is string
        && data.status in ['planned', 'walking', 'done']
        && data.assignedTo is list
        && data.stopIds is list
        && data.knockedIds is list
        // A route is walked on foot in an afternoon. The cap is here to stop a
        // runaway loop writing a document that breaches Firestore's own 1MB
        // limit, not because anybody would plan four hundred doors.
        && data.stopIds.size() <= 400
        && data.knockedIds.size() <= 400;
    }

    match /knockRoutes/{routeId} {
      allow read: if isCrew();
      allow create: if isCrew() && stampedByCaller('createdBy') && validKnockRoute();
      allow update: if isCrew() && refreshesAuthorStamp() && validKnockRoute();
      allow delete: if isCrew();
    }

    // Territories: a drawn area of ground somebody owns.
    //
    // The boundary is the whole document — a territory with a broken outline
    // does not draw, and one that draws in the wrong place silently hands
    // somebody the wrong streets. So the shape is checked: a list, and enough
    // points to actually enclose something.
    //
    // Individual vertices cannot be validated here (rules cannot walk a list),
    // which is why lib/db/territories.ts drops any point that is not two
    // numbers on the way back out.
    function validTerritory() {
      let data = request.resource.data;
      return data.name is string
        && data.boundary is list
        && data.boundary.size() >= 3
        // A hand-drawn outline follows streets: a handful of corners, not a
        // traced curve. The cap is a runaway-loop guard, not a design limit.
        && data.boundary.size() <= 200
        && data.assignedTo is list
        && data.active is bool;
    }

    match /territories/{territoryId} {
      allow read: if isCrew();
      allow create: if isCrew() && stampedByCaller('createdBy') && validTerritory();
      allow update: if isCrew() && refreshesAuthorStamp() && validTerritory();
      allow delete: if isCrew();
    }

    // Team chat.
    //
    // Membership is the entire access model: you can read and write a
    // conversation if and only if you are in its member list. Crew is not
    // enough — being allowed to use the app does not entitle you to read two
    // other people's private thread.
    //
    // `memberUids` is therefore pinned on update. Without that, "I may edit a
    // conversation I am in" combines with "I may add myself" into "I may read
    // any conversation", one write at a time.
    function chatMembers(conversationId) {
      return get(/databases/$(database)/documents/conversations/$(conversationId))
        .data.memberUids;
    }

    function inConversation(conversationId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && request.auth.uid in chatMembers(conversationId);
    }

    function validConversation() {
      let data = request.resource.data;
      return data.memberUids is list
        && data.memberUids.size() >= 2
        // A runaway loop must not write a document that breaches Firestore's
        // own 1MB limit. Nobody groups twenty people in a crew of three.
        && data.memberUids.size() <= 20
        && data.title is string;
    }

    match /conversations/{conversationId} {
      allow read: if isCrew() && request.auth.uid in resource.data.memberUids;

      // You must be in the conversation you are creating. One you started and
      // are not in would be unreadable to you the instant it existed.
      allow create: if isCrew()
        && validConversation()
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.createdBy == request.auth.uid;

      // Members may update the preview line that sending a message refreshes,
      // and the title. They may never change who is in it — see above.
      allow update: if isCrew()
        && request.auth.uid in resource.data.memberUids
        && validConversation()
        && request.resource.data.memberUids == resource.data.memberUids;

      // No delete. A thread is a record of what was said, and one member
      // erasing it for everybody is not a power worth having here.

      match /messages/{messageId} {
        allow read: if inConversation(conversationId);

        // Stamped with the sender, enforced rather than trusted: an
        // attribution that can be forged makes the whole thread worthless as
        // a record of who said what.
        allow create: if inConversation(conversationId)
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;

        // Messages are immutable. Editing or deleting one silently rewrites
        // what somebody else read.
        allow update, delete: if false;
      }

      // Where you had got up to. Your own document, and only yours — a map on
      // the conversation would let any member rewrite everybody's position.
      match /reads/{readerUid} {
        allow read, write: if inConversation(conversationId)
          && request.auth.uid == readerUid;
      }
    }

    // ----------------------------------------------------------------- ops
    //
    // The agent system's own state, published by grimebusters-ops and read by
    // the Marcus command centre at /marcus.
    //
    // Those scripts sign in as a crew account, exactly as create-estimate.ts
    // and log-lead.ts do, so every clause below applies to them. A service
    // account was not used and must not be: rules do not apply to one, and a
    // write key would bypass this whole file — including /users, which decides
    // who counts as crew.
    //
    // Crew-only throughout. This is the business's internal working state:
    // what is being worked on, what it costs, what is waiting on a decision.

    function validAgentStatus(status) {
      return status in ['working', 'waiting', 'idle'];
    }

    // The heartbeat is what the dashboard trusts, so it must be the server's
    // clock. A client-supplied time would let a stopped agent look current —
    // the one lie this screen exists not to tell.
    function freshHeartbeat() {
      return request.resource.data.heartbeatAt == request.time;
    }

    function validOpsAgent() {
      let data = request.resource.data;
      return validAgentStatus(data.status)
        && data.task is string
        && data.task.size() <= 300
        && freshHeartbeat();
    }

    // Document id is the agent id, so a publish is an upsert and there is
    // exactly one row per agent however many times it checks in.
    match /opsAgents/{agentId} {
      allow read: if isCrew();
      allow create: if isCrew()
        && agentId in ['marcus', 'grant', 'cole', 'reese', 'avery', 'tyler']
        && stampedByCaller('updatedBy')
        && validOpsAgent();
      allow update: if isCrew() && refreshesAuthorStamp() && validOpsAgent();

      // No delete. An agent that stops reporting goes stale on the screen,
      // which is information; a row that vanishes just looks like it never was.
      allow delete: if false;
    }

    function validFeedEntry() {
      let data = request.resource.data;
      return data.who in ['marcus', 'grant', 'cole', 'reese', 'avery', 'tyler']
        && data.text is string
        && data.text.size() > 0
        && data.text.size() <= 2000
        && data.createdAt == request.time;
    }

    // The comm log. Append-only, like the chat messages above and for the same
    // reason: it is a record of what the agents reported doing, and a record
    // that can be rewritten afterwards is not worth keeping.
    match /opsFeed/{entryId} {
      allow read: if isCrew();
      allow create: if isCrew() && stampedByCaller('createdBy') && validFeedEntry();
      allow update, delete: if false;
    }

    // A position in an escalation: who argued it, and what they argued.
    function validPosition(field) {
      let data = request.resource.data;
      return !(field in data) || data[field] == null
        || (data[field].who is string && data[field].position is string);
    }

    function validApproval() {
      let data = request.resource.data;
      return data.kind in ['money', 'content', 'escalation', 'legal']
        && data.who in ['marcus', 'grant', 'cole', 'reese', 'avery', 'tyler']
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.detail is string
        && data.detail.size() <= 2000
        && (data.cost == null || data.cost is string)
        && data.status is string
        && validPosition('positionA')
        && validPosition('positionB');
    }

    // The fields that describe *what is being asked*. Pinned on update, so the
    // agent that raised an item cannot change the price or the wording of a
    // thing after Nicolas has looked at it — an approval has to still mean
    // what it meant when it was read.
    function approvalContentUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny([
          'kind', 'who', 'title', 'detail', 'cost',
          'positionA', 'positionB', 'marcusRead',
          'approveLabel', 'altLabel',
          'createdAt', 'createdBy', 'createdByName'
        ]);
    }

    function recordsDecision() {
      let data = request.resource.data;
      return data.status in ['approved', 'alternate', 'rejected']
        && data.decidedAt == request.time
        && data.decidedBy == request.auth.uid
        && data.decidedByName is string;
    }

    match /opsApprovals/{approvalId} {
      allow read: if isCrew();

      // Raised by an agent, and it lands pending. One created already approved
      // would be an agent approving its own spend, which is hard rule 1 —
      // never commit money, any amount — dressed up as a data write.
      allow create: if isCrew()
        && stampedByCaller('createdBy')
        && validApproval()
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.decidedAt == null
        && request.resource.data.decidedBy == null;

      // The only permitted update is the decision itself, and only while the
      // item is still pending. A decided row is closed: re-deciding one that
      // has already been carried out would rewrite the record of what was
      // authorised. Changing course means raising a new item, which leaves
      // both the original and the reversal visible.
      allow update: if isCrew()
        && resource.data.status == 'pending'
        && approvalContentUnchanged()
        && recordsDecision();

      // No delete. What was asked for and what was answered both stay.
      allow delete: if false;
    }

    // Anything not matched above is denied by default. Do not add a
    // catch-all `match /{document=**}` here: rules are OR'd, so a permissive
    // catch-all would widen access rather than restrict it.
  }
}
