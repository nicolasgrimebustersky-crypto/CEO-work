<?xml version="1.0" encoding="UTF-8"?>
<!--
  Reference Info.plist for the iOS shell.

  `npx cap add ios` generates ios/App/App/Info.plist without any of the privacy
  keys this app needs. Copy the marked blocks into the generated file (or
  replace it wholesale — the non-marked keys below match what Capacitor emits).

  Every NS*UsageDescription here is shown verbatim in the iOS permission dialog
  and is read by App Review. A vague string ("This app needs your location") is
  one of the most common rejection reasons under Guideline 5.1.1 — each one has
  to say what is collected and what the user gets for it.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Grime Busters</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<!-- ===== Orientation =====
	     Portrait only. The whole UI is built for one-handed portrait use, and
	     shipping a landscape layout we have not designed invites a Guideline
	     2.1 rejection for a broken screen. iPad is not a target. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- ===== Dark UI =====
	     The app is dark end to end; letting iOS impose light mode on system
	     chrome produces white flashes against near-black screens. -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>

	<!-- ===== Privacy: location =====
	     Two strings because iOS asks twice. The "always" one is the one App
	     Review scrutinises: background location has to earn its place, so the
	     string names the concrete benefit rather than restating the feature. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Shows your position on the map so you can see which houses you have already knocked, and lets your crew partner see where you are while you split a street.</string>

	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Keeps your position visible to your crew partner while your phone is in your pocket between houses, so you do not knock the same door twice. You can turn sharing off at any time on the Account screen.</string>

	<!-- Legacy key, still read by iOS 10 and 11 era APIs. Keep it in sync. -->
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Keeps your position visible to your crew partner while your phone is in your pocket between houses, so you do not knock the same door twice. You can turn sharing off at any time on the Account screen.</string>

	<!-- ===== Privacy: camera =====
	     No photo library key: the app only ever takes new photos and never
	     browses the library, so requesting library access would be asking for
	     more than we use — which is itself a rejection reason. -->
	<key>NSCameraUsageDescription</key>
	<string>Takes before and after photos of a job and attaches them to that job&apos;s record.</string>

	<!-- ===== Background modes =====
	     `location` only. No audio, no fetch, no processing — declaring modes
	     the app does not use is a Guideline 2.5.4 rejection. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>remote-notification</string>
	</array>

	<!-- ===== Export compliance =====
	     The app uses HTTPS and Firebase, which is exempt encryption. Setting
	     this to false here means App Store Connect stops asking on every
	     single upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- ===== App Transport Security =====
	     No exceptions. Everything the app talks to (Firebase, Google Maps,
	     the Vercel API) is HTTPS, so ATS stays fully on. Do not add
	     NSAllowsArbitraryLoads to fix a local development problem — it has to
	     be justified to App Review and it weakens every request. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>

	<!-- ===== Outbound links =====
	     Tapping a customer's number opens the dialer; tapping Text opens
	     Messages. Without these iOS silently refuses to open the URL. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tel</string>
		<string>sms</string>
		<string>maps</string>
	</array>
</dict>
</plist>
