rules_version = '2';

// Job photos (Phase 4). Same two-account allowlist as Firestore — keep the two
// uid placeholders in sync with firestore.rules.

service firebase.storage {
  match /b/{bucket}/o {

    // Same second step as firestore.rules: this sign-in must have entered its
    // emailed code. See hasVerifiedSession() there for the reasoning.
    function hasVerifiedSession() {
      return request.auth != null
        && request.auth.token.auth_time is int
        && 'otpAuths' in request.auth.token
        && request.auth.token.otpAuths is list
        && request.auth.token.auth_time in request.auth.token.otpAuths;
    }

    function isCrew() {
      return request.auth != null
        && hasVerifiedSession()
        && request.auth.uid in [
             'Bzo7rclax4SdT7PaAua1monNxXG3',
             'QLMsTAHbbceHBAWBXPqtScGdGon2'
           ];
    }

    match /jobs/{jobId}/{fileName} {
      allow read: if isCrew();

      // Cap uploads at 15 MB and images only — these come straight off a phone
      // camera, so anything outside that is a bug or an abuse.
      allow create, update: if isCrew()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // Delete is listed separately because `request.resource` is null on a
      // delete: folding it into the rule above would make every delete fail
      // the size check and leave orphaned files behind.
      allow delete: if isCrew();
    }
  }
}
