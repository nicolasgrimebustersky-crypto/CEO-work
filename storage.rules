rules_version = '2';

// Job photos (Phase 4) and expense receipts. Same two-account allowlist as Firestore — keep the two
// uid placeholders in sync with firestore.rules.

service firebase.storage {
  match /b/{bucket}/o {

    // Same second step as firestore.rules: this sign-in must have entered its
    // emailed code. See hasVerifiedSession() there for the reasoning.
    function hasVerifiedSession() {
      return request.auth != null
        && request.auth.token.auth_time is int
        && 'otpAuths' in request.auth.token
        && request.auth.token.otpAuths is list
        && request.auth.token.auth_time in request.auth.token.otpAuths;
    }

    // Same email check as isAdmin() in firestore.rules. The owner is crew
    // there, so the owner is crew here too, whatever account they sign in on.
    function isAdmin() {
      return request.auth != null
        && 'email' in request.auth.token
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'nicolas.grimebustersky@gmail.com';
    }

    // Anyone the owner has approved in the app: their profile says role
    // 'crew'. The same test as isApprovedCrew() in firestore.rules, read
    // across services, so approving a hire on the Account screen is all it
    // takes — no rules change per person. A pending sign-up, a removed crew
    // member and a customer-portal account have no such profile and stay out.
    //
    // Cross-service reads need the Storage service agent to hold
    // roles/firebaserules.firestoreServiceAgent on the project; without it this
    // read fails closed and only the owner and the listed crew get in.
    function isApprovedCrew() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'crew';
    }

    function isCrew() {
      return request.auth != null
        && hasVerifiedSession()
        && (isAdmin() || isApprovedCrew() || request.auth.uid in [
             'Bzo7rclax4SdT7PaAua1monNxXG3',
             'QLMsTAHbbceHBAWBXPqtScGdGon2'
           ]);
    }

    match /jobs/{jobId}/{fileName} {
      allow read: if isCrew();

      // Cap uploads at 15 MB and images only — these come straight off a phone
      // camera, so anything outside that is a bug or an abuse.
      allow create, update: if isCrew()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // Delete is listed separately because `request.resource` is null on a
      // delete: folding it into the rule above would make every delete fail
      // the size check and leave orphaned files behind.
      allow delete: if isCrew();
    }

    // Expense receipts: a photo off the phone camera, or a PDF of an emailed
    // receipt. Filed under the uid of whoever the expense belongs to: that
    // person and the owner may open and replace it, nobody else — a receipt
    // is the business's spending, which the rest of the crew does not see.
    match /expenses/{ownerUid}/{expenseId}/{fileName} {
      allow read: if isCrew() && (isAdmin() || request.auth.uid == ownerUid);
      allow create, update: if isCrew()
        && (isAdmin() || request.auth.uid == ownerUid)
        && request.resource.size < 15 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
      allow delete: if isCrew() && (isAdmin() || request.auth.uid == ownerUid);
    }

    // W-9s. A W-9 carries a Social Security or tax ID number, so only the
    // owner can upload, open or delete one — not even the person it is for
    // reads it back from here.
    match /w9/{uid}/{fileName} {
      allow read, delete: if isCrew() && isAdmin();
      allow create, update: if isCrew() && isAdmin()
        && request.resource.size < 15 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
    }

    // Files attached to an estimate or invoice — a scope of work, a
    // certificate of insurance, a site photo. Crew-only, like job photos.
    // Customers never read these directly: their copy of the document asks the
    // server, which checks the document's share token and hands back a link
    // that expires in minutes (app/api/files/[token]/[fileId]).
    //
    // PDFs and ordinary photos only. HTML and SVG are refused outright: either
    // one opened from the storage domain can run script.
    match /documents/{documentId}/files/{fileName} {
      allow read: if isCrew();

      allow create, update: if isCrew()
        && request.resource.size < 20 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf'
            || request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)'));

      allow delete: if isCrew();
    }
  }
}
